{
  "name": "fenrir-library",
  "version": "1.0.0",
  "description": "A full-stack online library: browse, search by genre/title, read book pages, log in, customize your profile, and leave comments and reactions. Built with HTML/CSS/JS, Node.js/Express and PostgreSQL.",
  "license": "Unlicense",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "scrape": "node scripts/scrape.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "test": "node --test test/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
