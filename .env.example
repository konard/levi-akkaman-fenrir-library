# Copy this file to ".env" and adjust the values for your environment.

# HTTP port the server listens on.
PORT=3000

# --- PostgreSQL connection -------------------------------------------------
# You can either provide a single DATABASE_URL connection string ...
DATABASE_URL=postgres://fenrir:fenrir@localhost:5432/fenrir_library
# ... or the individual parts below (DATABASE_URL takes precedence if set).
PGHOST=localhost
PGPORT=5432
PGUSER=fenrir
PGPASSWORD=fenrir
PGDATABASE=fenrir_library

# Set to "true" when connecting to a managed database that requires SSL.
PGSSL=false

# --- Authentication --------------------------------------------------------
# Secret used to sign JSON Web Tokens. CHANGE THIS to a long random string in
# production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET=change-me-to-a-long-random-secret
# How long a login session token stays valid.
JWT_EXPIRES_IN=7d

# --- Book scraper ----------------------------------------------------------
# How many books the `npm run scrape` command imports per run.
SCRAPE_LIMIT=48
# Public catalogue API used by the scraper (Project Gutenberg via Gutendex).
GUTENDEX_URL=https://gutendex.com/books
